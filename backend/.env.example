# Copiez ce fichier en « .env » (dans le dossier backend) puis adaptez les valeurs. Ne le publiez jamais.

# --- Base de données (SQLite par défaut ; PostgreSQL : postgresql+psycopg://user:motdepasse@localhost:5432/agriconnect) ---
DATABASE_URL=sqlite:///./agriconnect.db

# --- Sécurité ---
# Générez une valeur longue et aléatoire :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
COOKIE_SECURE=false            # mettre true derrière HTTPS (obligatoire en production)
SESSION_HOURS=24
CORS_ORIGINS=http://localhost:5173

# --- Compte administrateur créé au premier lancement ---
ADMIN_EMAIL=admin@agriconnect.local
ADMIN_PASSWORD=ChangezMoi2026

# --- Application ---
APP_URL=http://localhost:3000  # base des liens d'invitation envoyés aux candidats
ACTIVATION_DAYS=7
RESET_PASSWORD_HOURS=2
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_LIST_ROWS=1000
SEED_DEMO=false                # true = crée les données et comptes de DÉMONSTRATION au démarrage

# --- Paiements ---
# demo = simulation (aucun argent réel). live = passerelle réelle : à n'activer qu'après implémentation et tests (voir README).
PAYMENT_MODE=demo
BILLING_ENABLED=true             # false en local pour tester sans écran ni blocage d'abonnement
PAYMENT_PROVIDER=demo
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Courriel (facultatif ; sans SMTP_HOST, les liens d'invitation sont affichés et exportés par l'administration) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AgriConnect <no-reply@votredomaine.bj>
